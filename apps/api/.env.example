PORT=3001
NODE_ENV=development

# Neon Serverless PostgreSQL Database URL (pooled connection recommended for API)
DATABASE_URL="postgresql://postgres:password@postgres:5432/flashsale?connection_limit=20"

# Redis (for Redlock distributed locking and rate limiting)
REDIS_URL="redis://localhost:6379"

# MongoDB (for product catalog caching)
MONGO_URI="mongodb://root:password@localhost:27017/flashsale?authSource=admin"

# Authentication
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars"

# Razorpay (Mock or Test Keys)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="whsec_placeholder"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"
