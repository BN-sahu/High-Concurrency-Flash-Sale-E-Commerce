NODE_ENV=development

# Neon Serverless PostgreSQL Database URL (unpooled connection recommended for background jobs/migrations, but pooled works if connection-bound)
DATABASE_URL="postgresql://postgres:password@postgres:5432/flashsale?connection_limit=10"

# Redis (for BullMQ job queues)
REDIS_URL="redis://localhost:6379"

# Razorpay (Mock or Test Keys)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="secret_placeholder"
