datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

// ============ Users & Auth ============
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  role          Role      @default(CUSTOMER)

  sessions      Session[]
  reservations  Reservation[]
  orders        Order[]
  payments      Payment[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([email])
  @@index([role])
}

enum Role {
  CUSTOMER
  ADMIN
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  token         String    @unique
  expiresAt     DateTime

  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============ Products & Inventory ============
model Product {
  id            String    @id @default(cuid())
  name          String
  description   String    @default("")
  price         Decimal   @db.Decimal(10, 2)
  currency      String    @default("USD")

  // Reference to MongoDB catalog (denormalized for quick access)
  mongoId       String?

  status        ProductStatus @default(ACTIVE)
  imageUrl      String?

  inventory     Inventory?
  reservations  Reservation[]
  orderItems    OrderItem[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
  COMING_SOON
}

// ============ CRITICAL: Inventory (State Machine) ============
model Inventory {
  id                 String    @id @default(cuid())
  productId          String    @unique
  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Total units available
  totalQuantity      Int       @default(0)

  // Atomic counters — INVARIANT: totalQuantity = available + reserved + sold
  availableQuantity  Int       @default(0)
  reservedQuantity   Int       @default(0)
  soldQuantity       Int       @default(0)

  reservations       Reservation[]

  // Optimistic concurrency control
  versionLock        Int       @default(0)

  updatedAt          DateTime  @updatedAt

  @@index([productId])
}

// ============ CRITICAL: Reservation (Atomic State) ============
model Reservation {
  id                String           @id @default(cuid())
  inventoryId       String
  inventory         Inventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  productId         String
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  quantity          Int              @default(1)

  // State machine: RESERVED → PAYMENT_PENDING → SOLD / EXPIRED / FAILED
  state             ReservationState @default(RESERVED)

  // Expiration: auto-release if not paid within X minutes
  expiresAt         DateTime

  // Link to checkout and payment
  checkoutSessionId String?
  checkoutSession   CheckoutSession? @relation(fields: [checkoutSessionId], references: [id])

  paymentId         String?
  payment           Payment?         @relation(fields: [paymentId], references: [id])

  // Idempotency for duplicate requests
  idempotencyKey    String?          @unique

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([inventoryId, userId, checkoutSessionId])
  @@index([inventoryId])
  @@index([userId])
  @@index([state])
  @@index([expiresAt])
}

enum ReservationState {
  RESERVED
  PAYMENT_PENDING
  SOLD
  EXPIRED
  FAILED
}

// ============ Checkout Session (Time-Limited) ============
model CheckoutSession {
  id            String         @id @default(cuid())

  userId        String

  // Expires after 10 minutes
  expiresAt     DateTime

  status        CheckoutStatus @default(ACTIVE)

  // Link reservations to checkout
  reservations  Reservation[]

  // Final order if payment succeeded
  orderId       String?
  order         Order?         @relation("CheckoutToOrder", fields: [orderId], references: [id])

  // Razorpay Order ID
  gatewayOrderId String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([status])
}

enum CheckoutStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  ABANDONED
}

// ============ Orders ============
model Order {
  id                String           @id @default(cuid())
  orderNumber       String           @unique

  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  status            OrderStatus      @default(PENDING)

  totalAmount       Decimal          @db.Decimal(10, 2)
  currency          String           @default("USD")

  items             OrderItem[]

  payment           Payment?

  checkoutSessions  CheckoutSession[] @relation("CheckoutToOrder")

  shippingAddress   String?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId     String
  product       Product   @relation(fields: [productId], references: [id])

  quantity      Int
  unitPrice     Decimal   @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

// ============ CRITICAL: Payments (Razorpay Integration) ============
model Payment {
  id                    String        @id @default(cuid())

  orderId               String        @unique
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("INR")

  // Razorpay references
  gatewayOrderId        String        @unique
  gatewayPaymentId      String?       @unique

  // Idempotency: prevent duplicate charges
  idempotencyKey        String        @unique

  status                PaymentStatus @default(PENDING)

  reservations          Reservation[]

  // Reconciliation
  confirmedAt           DateTime?
  failedAt              DateTime?
  failureReason         String?
  refundedAt            DateTime?
  refundAmount          Decimal?      @db.Decimal(10, 2)

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
  REFUNDED
}

// ============ Idempotency (Prevents Duplicate Operations) ============
model IdempotencyKey {
  key           String            @id

  // Result of the operation (JSON)
  result        Json

  // Status
  status        IdempotencyStatus @default(PROCESSING)

  expiresAt     DateTime          // TTL: 24 hours

  createdAt     DateTime          @default(now())

  @@index([expiresAt])
}

enum IdempotencyStatus {
  PROCESSING
  SUCCESS
  FAILURE
}

// ============ Transactional Outbox (Event Publishing) ============
model OutboxEvent {
  id            String    @id @default(cuid())

  eventType     String    // e.g., "order.created", "payment.confirmed"
  aggregateId   String    // e.g., orderId

  payload       Json

  published     Boolean   @default(false)
  publishedAt   DateTime?

  createdAt     DateTime  @default(now())

  @@index([published])
  @@index([eventType])
  @@index([aggregateId])
}

// ============ Audit & Security ============
model AuditLog {
  id            String    @id @default(cuid())

  userId        String?
  action        String    // e.g., "reservation.created", "payment.confirmed"
  resource      String    // e.g., "Reservation", "Payment"
  resourceId    String

  changes       Json?     // Before/after values

  ipAddress     String?
  userAgent     String?

  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([action])
  @@index([resourceId])
  @@index([createdAt])
}
